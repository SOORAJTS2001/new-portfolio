						>
					</Label>
					<Label
						title='Connect on Linkedin'
						as='a'
						href='https://in.linkedin.com/in/sooraj-t-s-58b9001a9'
						target='_blank'
					>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							viewBox='0 0 16 16'
							slot='icon'
							class='h-5 w-5 text-foreground/75'
